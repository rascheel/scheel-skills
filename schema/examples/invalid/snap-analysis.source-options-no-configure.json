{
  "schema_version": "1.3",
  "target_arch": null,
  "project": {
    "name": "simple-server",
    "version": "0.1.0",
    "summary": "A tiny HTTP daemon",
    "description": "INVALID: records snap options but does not list the configure hook.",
    "license": "MIT",
    "grade": "stable"
  },
  "snap": {
    "base": "core24",
    "confinement": "strict",
    "classic_reason": null
  },
  "build": {
    "plugin": "dump",
    "plugin_config": {
      "source": "."
    },
    "build_packages": [],
    "stage_packages": [
      "busybox"
    ],
    "override_build_extra": null
  },
  "apps": [
    {
      "name": "daemon",
      "command": "bin/simple-server",
      "daemon": "simple",
      "plugs": [
        "network-bind"
      ],
      "environment": {}
    }
  ],
  "hooks": [
    "install"
  ],
  "layouts": {},
  "interfaces": [
    {
      "name": "network-bind",
      "apps": [
        "daemon"
      ],
      "auto_connected": true,
      "reason": "Listens for HTTP requests."
    }
  ],
  "config_options": [
    {
      "key": "daemon.port",
      "source": "snapctl",
      "type": "port",
      "allowed_values": [],
      "default": "8080",
      "restart_required": true
    },
    {
      "key": "daemon.host",
      "source": "snapctl",
      "type": "string",
      "allowed_values": [],
      "default": "0.0.0.0",
      "restart_required": true
    },
    {
      "key": "daemon.msg",
      "source": "snapctl",
      "type": "string",
      "allowed_values": [],
      "default": "Hello",
      "restart_required": true
    },
    {
      "key": "log.level",
      "source": "snapctl",
      "type": "enum",
      "allowed_values": [
        "info",
        "debug"
      ],
      "default": "info",
      "restart_required": true
    },
    {
      "key": "debug",
      "source": "snapctl",
      "type": "boolean",
      "allowed_values": [],
      "default": "false",
      "restart_required": true
    }
  ],
  "notes": [
    "The daemon reads every option with snapctl get once at startup, so changes need a restart."
  ]
}
